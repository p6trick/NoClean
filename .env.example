# Copy to .env, edit both paths, then: source .env
# Drive asset folder containing checkpoints/ and at_models/
export N2N_ASSET_ROOT=/path/to/N2N_assets
# Existing archive layout containing PGD/, BIM/, AA/, Self2Self/, FGSM/
# For the separate image bundle, use /path/to/N2N_data/PM
export N2N_PM_ROOT=/path/to/PM
# Optional overrides:
# export N2N_CHECKPOINT_ROOT=/path/to/N2N_assets/checkpoints
# export N2N_AT_MODEL_ROOT=/path/to/N2N_assets/at_models
